# ── make deploy 설정 ─────────────────────────────────────────────
# 이 파일을 deploy.env 로 복사해서 값을 채우세요. (deploy.env 는 git 에 안 올라감)
#   cp deploy.env.example deploy.env
# 만드는 법 전체 가이드: backend/DEPLOY.md

# 전용 GCP 프로젝트 ID (맥OS 구글계정 말고, 이 프로젝트용으로 만든 계정의 프로젝트)
GCP_PROJECT=your-ezmerce-project-id
GCP_REGION=asia-northeast3          # 서울
GCP_SERVICE=ezmerce-api             # Cloud Run 서비스명
GCP_REPO=ezmerce                    # Artifact Registry 저장소명

# 인증 = 기본은 'make deploy-login' (브라우저 로그인, 키 파일 불필요).
#  ※ 조직 정책(iam.disableServiceAccountKeyCreation)으로 서비스계정 키가 막히면 로그인 방식 사용.
#  (드물게) 서비스계정 키를 쓸 수 있는 환경이면 아래 주석 풀고 경로 지정:
# GCP_SA_KEY=secrets/ezmerce-deploy-sa.json

# 백엔드 런타임 env (비밀 아님)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# ⚠️ PUBLIC_BASE_URL = "프론트(공개 카드)" 도메인 (= Firebase Hosting URL, 보통 https://<GCP_PROJECT>.web.app).
# QR·공개카드·엑셀 QR 링크가 전부 이 prefix 를 쓴다 → 공개 카드 페이지(/p?code=)는 프론트가 서빙.
# 🚫 절대 백엔드/API(Cloud Run) URL 넣지 말 것 — API 주소가 QR·엑셀로 외부 공개돼 버린다.
PUBLIC_BASE_URL=https://YOUR-PROJECT.web.app

# ── 프론트 배포(make deploy-web, Firebase Hosting) ──
# WEB_API_BASE_URL = 프론트가 호출할 "백엔드 API" URL (NEXT_PUBLIC_API_BASE_URL 로 빌드에 주입).
# ⚠️ PUBLIC_BASE_URL(프론트 도메인)과 다르다 — 이건 백엔드 Cloud Run URL 이 맞음(브라우저→API 호출용).
# 프론트 Supabase 키(NEXT_PUBLIC_SUPABASE_*)는 apps/web/.env.local 에서 자동으로 읽힘.
WEB_API_BASE_URL=https://YOUR-BACKEND.run.app

# 비밀: Supabase service_role 키 — `make deploy-setup` 이 Secret Manager 에 올릴 때만 사용.
# (Supabase 대시보드 → Project Settings → API → service_role key)
SUPABASE_SERVICE_KEY=PASTE_SERVICE_ROLE_KEY_FOR_SETUP_ONLY
