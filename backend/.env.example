# ezmerce backend 환경변수 예시 — 복사해서 채우기: cp .env.example .env
# (config.py 가 backend/.env 또는 환경변수에서 읽음. 시크릿은 절대 커밋 금지)

# Supabase 프로젝트 (대시보드: Settings → API / API Keys / JWT Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=          # Secret 키(sb_secret_…) 또는 레거시 service_role — 서버 전용, 프론트/깃 금지

# QR 공개 카드 URL prefix — 프론트 공개 카드 = {PUBLIC_BASE_URL}/p?code=EZM-…
# dev=프론트 포트(3555) / 폰 스캔=LAN IP / 운영=Firebase 도메인(예: https://shop.ezmerce.io)
PUBLIC_BASE_URL=http://localhost:3555

# 품번(platform_code) 접두
PLATFORM_CODE_PREFIX=EZM

# ── GCS(파일 저장소) — Supabase Storage 대체. ⚠️ Storage 만 GCS, DB/Auth/JWT 는 위 SUPABASE_* 유지 ──
# 버킷 2개: 공개(상품 이미지) + 비공개(가입 서류 PII). 로컬 서명은 ADC 필요:
#   gcloud auth application-default login   (또는 GOOGLE_APPLICATION_CREDENTIALS 키 경로)
GCS_PROJECT=your-gcp-project-id
GCS_PRODUCT_BUCKET=ezmerce-product-images                              # 공개 read 버킷
GCS_DOC_BUCKET=ezmerce-business-docs                                   # 비공개 버킷(서비스계정 전용)
GCS_PUBLIC_BASE=https://storage.googleapis.com/ezmerce-product-images  # 공개 URL prefix(CDN 쓰면 변경)
GCS_SIGNING_SA=PROJECTNUMBER-compute@developer.gserviceaccount.com     # 키리스 V4 서명용 런타임 SA
