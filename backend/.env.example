# ezmerce backend 환경변수 예시 — 복사해서 채우기: cp .env.example .env
# (config.py 가 backend/.env 또는 환경변수에서 읽음. 시크릿은 절대 커밋 금지)

# Supabase 프로젝트 (대시보드: Settings → API / API Keys / JWT Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=          # Secret 키(sb_secret_…) 또는 레거시 service_role — 서버 전용, 프론트/깃 금지
# JWT 검증은 JWKS 공개키(ES256)로 하며 SUPABASE_URL 에서 자동 파생됨.
# 아래 SUPABASE_JWT_SECRET 은 레거시(HS256, 대칭) 프로젝트에서만 필요(선택).
SUPABASE_JWT_SECRET=

# QR 공개 카드 URL prefix (예: https://shop.ezmerce.io)
PUBLIC_BASE_URL=http://localhost:3000

# 품번(platform_code) 접두
PLATFORM_CODE_PREFIX=EZM
