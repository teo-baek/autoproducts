# ezmerce backend 환경변수 예시 — 복사해서 채우기: cp .env.example .env
# (config.py 가 backend/.env 또는 환경변수에서 읽음. 시크릿은 절대 커밋 금지)

# Supabase 프로젝트
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # service role 키 — 서버 전용, 프론트 노출 금지
SUPABASE_JWT_SECRET=           # JWT 검증용 secret

# QR 공개 카드 URL prefix (예: https://shop.ezmerce.io)
PUBLIC_BASE_URL=http://localhost:3000

# 품번(platform_code) 접두
PLATFORM_CODE_PREFIX=EZM
