# apps/web 환경변수 — 이 파일을 복사해 .env.local 로 만들고 값 채우기 (.env.local 은 gitignore)
# Supabase 프로젝트 → Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>   # ⚠️ anon(public) 키. service key 절대 금지
# FastAPI 백엔드 base URL (로컬 기본 8444)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8444
# 공개 이미지 URL prefix(GCS 공개 버킷). ⚠️ 백엔드 GCS_PUBLIC_BASE 와 동일해야 함(불일치 시 엑셀 사진 누락)
NEXT_PUBLIC_GCS_PUBLIC_BASE=https://storage.googleapis.com/ezmerce-product-images
